APP_NAME=sdnflow-inference-api
APP_VERSION=1.0.0
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
LOG_DIRECTORY=./logs
LOG_FILENAME=sdn_mpls_ml_api.log
LOG_FILE_MAX_BYTES=10485760
LOG_FILE_BACKUP_COUNT=5
ENABLE_PROMETHEUS_METRICS=true
INSTANCE_ID=
# Set only when running multiple application workers:
# PROMETHEUS_MULTIPROC_DIR=/tmp/sdnflow-prometheus
CLASSIFICATION_MODE=MODEL
MODEL_DIR=../models
CONFIG_DIR=../configs
MODEL_FILENAME=sdn_mpls_ml_model.json
MODEL_METADATA_FILENAME=sdn_mpls_ml_model_meta.json
POLICY_FILENAME=sdn_mpls_ml_traffic_class_to_policy_mapping.json
DETERMINISTIC_RULE_FILENAME=sdn_mpls_ml_traffic_class_deterministic_rules.json
ENABLE_POLICY_MAPPING=true
CLASSIFIER_POOL_SIZE=5
REQUEST_TIMEOUT_SECONDS=10
MAX_REQUEST_BODY_BYTES=16384
PROBABILITY_TOLERANCE=0.001
MIN_TUNNEL_BANDWIDTH_KBPS=10000
MAX_TUNNEL_BANDWIDTH_KBPS=100000
MIN_POLICY_CONFIDENCE=0.75
