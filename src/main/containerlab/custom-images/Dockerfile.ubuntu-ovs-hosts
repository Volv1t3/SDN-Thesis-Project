FROM openeuler/openvswitch:latest

USER root

# Create the lab user and set a password that does not contain the username.
RUN useradd -m -s /bin/bash clab \
    && echo 'clab:EdgeNode#2026' | chpasswd \
    && usermod -U clab

# Install SSH plus network/admin tooling.
RUN dnf update -y \
    && dnf install -y \
       openssh-server \
       openssh-clients \
       iproute \
       net-tools \
       iputils \
       procps-ng \
       tcpdump \
       traceroute \
       nmap-ncat \
       curl \
       wget \
       vim \
       less \
       which \
       hostname \
       iperf3 \
       ethtool \
       bind-utils \
       lsof \
       rsync \
       sudo \
    && dnf clean all \
    && rm -rf /var/cache/dnf

# Allow the lab user to escalate without prompting.
RUN echo 'clab ALL=(ALL) NOPASSWD:ALL' > /etc/sudoers.d/clab \
    && chmod 440 /etc/sudoers.d/clab

# Prepare SSH host keys and replace the sshd config with a minimal known-good one.
RUN mkdir -p /var/run/sshd /run/sshd \
    && ssh-keygen -A \
    && cat > /etc/ssh/sshd_config <<'EOF'
Port 22
Protocol 2
ListenAddress 0.0.0.0
ListenAddress ::
HostKey /etc/ssh/ssh_host_rsa_key
HostKey /etc/ssh/ssh_host_ecdsa_key
HostKey /etc/ssh/ssh_host_ed25519_key
PermitRootLogin yes
PasswordAuthentication yes
KbdInteractiveAuthentication no
ChallengeResponseAuthentication no
PubkeyAuthentication yes
UsePAM no
X11Forwarding no
PrintMotd no
Subsystem sftp /usr/libexec/openssh/sftp-server
EOF

EXPOSE 22 6640 6653

CMD ["/bin/bash", "-lc", "mkdir -p /var/run/sshd /run/sshd && ssh-keygen -A >/dev/null 2>&1 || true; exec /usr/sbin/sshd -D -e -f /etc/ssh/sshd_config"]