<?xml version="1.0" encoding="UTF-8"?>
<!--
  Blueprint container definition for the SDN-MPLS-ML controller application.

  OpenDaylight/Karaf uses this file to instantiate the provider class when the
  bundle is loaded.

  The init-method runs when the Blueprint container starts.
  The destroy-method runs when the Blueprint container is stopped.
-->
<blueprint xmlns="http://www.osgi.org/xmlns/blueprint/v1.0.0">

    <reference id="notificationService"
               interface="org.opendaylight.mdsal.binding.api.NotificationService"/>
    <reference id="dataBroker"
               interface="org.opendaylight.mdsal.binding.api.DataBroker"/>

    <bean id="sdnMplsMlProvider"
          class="com.sma.sdn.impl.SDN_MPLS_ML_Provider"
          init-method="init"
          destroy-method="close">
        <argument ref="notificationService"/>
        <argument ref="dataBroker"/>
    </bean>

</blueprint>
