###
POST http://172.21.121.100:8181/rests/operations/network-topology-pcep:add-lsp HTTP/1.1
Authorization: Basic {{odl_basic_auth}}
Accept: application/xml
Content-Type: application/xml

<input xmlns="urn:opendaylight:params:xml:ns:yang:topology:pcep">
    <node>pcc://10.100.10.1</node>
    <name>sma-lsr1-lsr4-cspf-test</name>

    <arguments>
        <path-setup-type>
            <pst>rsvp-te</pst>
        </path-setup-type>

        <lsp>
            <lsp-flags>
                <delegate>true</delegate>
                <administrative>true</administrative>
            </lsp-flags>
        </lsp>

        <endpoints-obj>
            <ipv4>
                <source-ipv4-address>11.11.11.11</source-ipv4-address>
                <destination-ipv4-address>14.14.14.14</destination-ipv4-address>
            </ipv4>
        </endpoints-obj>

        <ero>
            <subobject>
                <loose>false</loose>
                <ip-prefix>
                    <ip-prefix>10.0.12.2/32</ip-prefix>
                </ip-prefix>
            </subobject>

            <subobject>
                <loose>false</loose>
                <ip-prefix>
                    <ip-prefix>10.0.25.2/32</ip-prefix>
                </ip-prefix>
            </subobject>

            <subobject>
                <loose>false</loose>
                <ip-prefix>
                    <ip-prefix>14.14.14.14/32</ip-prefix>
                </ip-prefix>
            </subobject>
        </ero>
    </arguments>
    <network-topology-ref xmlns:nt="urn:TBD:params:xml:ns:yang:network-topology">/nt:network-topology/nt:topology[nt:topology-id="pcep-topology"]</network-topology-ref>
</input>
